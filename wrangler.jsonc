{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magistrala-docs-v0-51-0",
  "main": "workers/image-proxy.ts",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "absmach.eu/docs/magistrala/v0-51-0/*",
      "zone_name": "absmach.eu"
    }
  ],
  "assets": {
    "directory": "./out",
    // Only these paths are routed to the Worker (workers/image-proxy.ts);
    // everything else (docs pages, JS/CSS, existing public/ files) is
    // matched against the static export in ./out first, unchanged.
    "run_worker_first": [
      "/docs/magistrala/v0-51-0/img/*",
      "/docs/magistrala/v0-51-0/diagrams/*",
      "/docs/magistrala/v0-51-0/screenshots/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "websites-images",
      // Local dev (`wrangler pages dev`) hits the real bucket instead of an
      // empty local simulator, so images published via publish-image.mjs
      // are visible immediately without manually seeding local R2 state.
      // No effect on the deployed Worker -- bindings are always real there.
      "remote": true
    }
  ]
}
